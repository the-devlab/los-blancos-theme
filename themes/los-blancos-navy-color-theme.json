{
  "$schema": "vscode://schemas/color-theme",
  "name": "Los Blancos Navy",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "focusBorder": "#FCBF00",
    "foreground": "#E8EDF5",
    "descriptionForeground": "#8A9BB5",
    "errorForeground": "#FF6B7F",
    "icon.foreground": "#C9D4E5",
    "selection.background": "#2A6BC066",
    "widget.shadow": "#00000080",
    "textLink.foreground": "#6FA8F0",
    "textLink.activeForeground": "#FCBF00",

    "editor.background": "#0B1B33",
    "editor.foreground": "#E8EDF5",
    "editorCursor.foreground": "#FCBF00",
    "editor.lineHighlightBackground": "#11264A",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#2A6BC077",
    "editor.inactiveSelectionBackground": "#2A6BC040",
    "editor.selectionHighlightBackground": "#FCBF0022",
    "editor.wordHighlightBackground": "#FFFFFF14",
    "editor.wordHighlightStrongBackground": "#FCBF0026",
    "editor.findMatchBackground": "#FCBF0066",
    "editor.findMatchBorder": "#FCBF00",
    "editor.findMatchHighlightBackground": "#FCBF0030",
    "editor.rangeHighlightBackground": "#FFFFFF0D",
    "editorLineNumber.foreground": "#4A5F80",
    "editorLineNumber.activeForeground": "#FCBF00",
    "editorIndentGuide.background1": "#1A2F52",
    "editorIndentGuide.activeBackground1": "#34507D",
    "editorWhitespace.foreground": "#24395E",
    "editorBracketMatch.background": "#FCBF0022",
    "editorBracketMatch.border": "#FCBF0099",
    "editorBracketHighlight.foreground1": "#FCBF00",
    "editorBracketHighlight.foreground2": "#6FA8F0",
    "editorBracketHighlight.foreground3": "#FFFFFF",
    "editorRuler.foreground": "#1C3358",
    "editorGutter.addedBackground": "#4CAF50",
    "editorGutter.modifiedBackground": "#FCBF00",
    "editorGutter.deletedBackground": "#E62644",
    "editorError.foreground": "#FF6B7F",
    "editorWarning.foreground": "#FFA552",
    "editorInfo.foreground": "#6FA8F0",

    "editorWidget.background": "#0F2240",
    "editorWidget.border": "#1C3358",
    "editorSuggestWidget.background": "#0F2240",
    "editorSuggestWidget.border": "#1C3358",
    "editorSuggestWidget.selectedBackground": "#00499699",
    "editorSuggestWidget.highlightForeground": "#FCBF00",
    "editorHoverWidget.background": "#0F2240",
    "editorHoverWidget.border": "#1C3358",

    "activityBar.background": "#081428",
    "activityBar.foreground": "#FFFFFF",
    "activityBar.inactiveForeground": "#5C7091",
    "activityBar.activeBorder": "#FCBF00",
    "activityBar.activeBackground": "#08274C",
    "activityBar.border": "#081428",
    "activityBarBadge.background": "#FCBF00",
    "activityBarBadge.foreground": "#000000",

    "sideBar.background": "#081428",
    "sideBar.foreground": "#C9D4E5",
    "sideBar.border": "#081428",
    "sideBarTitle.foreground": "#FFFFFF",
    "sideBarSectionHeader.background": "#081428",
    "sideBarSectionHeader.foreground": "#FFFFFF",
    "sideBarSectionHeader.border": "#11264A",

    "list.activeSelectionBackground": "#00499699",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.inactiveSelectionBackground": "#13284B",
    "list.hoverBackground": "#0F2240",
    "list.focusOutline": "#FCBF0066",
    "list.highlightForeground": "#FCBF00",

    "titleBar.activeBackground": "#081428",
    "titleBar.activeForeground": "#FFFFFF",
    "titleBar.inactiveBackground": "#081428",
    "titleBar.inactiveForeground": "#5C7091",
    "titleBar.border": "#081428",

    "tab.activeBackground": "#08274C",
    "tab.activeForeground": "#FFFFFF",
    "tab.activeBorderTop": "#FCBF00",
    "tab.activeBorder": "#08274C",
    "tab.inactiveBackground": "#081428",
    "tab.inactiveForeground": "#6B7F9E",
    "tab.hoverBackground": "#0F2240",
    "tab.border": "#081428",
    "tab.unfocusedActiveBorderTop": "#FCBF0080",
    "editorGroupHeader.tabsBackground": "#081428",
    "editorGroupHeader.tabsBorder": "#081428",
    "editorGroup.border": "#11264A",
    "breadcrumb.foreground": "#7388A6",
    "breadcrumb.focusForeground": "#FFFFFF",
    "breadcrumb.activeSelectionForeground": "#FCBF00",

    "statusBar.background": "#004996",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.border": "#004996",
    "statusBar.noFolderBackground": "#003670",
    "statusBar.debuggingBackground": "#FCBF00",
    "statusBar.debuggingForeground": "#000000",
    "statusBarItem.hoverBackground": "#FFFFFF26",
    "statusBarItem.remoteBackground": "#E62644",
    "statusBarItem.remoteForeground": "#FFFFFF",

    "panel.background": "#081428",
    "panel.border": "#11264A",
    "panelTitle.activeForeground": "#FFFFFF",
    "panelTitle.activeBorder": "#FCBF00",
    "panelTitle.inactiveForeground": "#6B7F9E",

    "terminal.background": "#081428",
    "terminal.foreground": "#E8EDF5",
    "terminalCursor.foreground": "#FCBF00",
    "terminal.ansiBlack": "#0B1B33",
    "terminal.ansiRed": "#E62644",
    "terminal.ansiGreen": "#7BC67E",
    "terminal.ansiYellow": "#FCBF00",
    "terminal.ansiBlue": "#5B9BE6",
    "terminal.ansiMagenta": "#E07AB8",
    "terminal.ansiCyan": "#6FD3D3",
    "terminal.ansiWhite": "#E8EDF5",
    "terminal.ansiBrightBlack": "#4A5F80",
    "terminal.ansiBrightRed": "#FF6B7F",
    "terminal.ansiBrightGreen": "#9BE09E",
    "terminal.ansiBrightYellow": "#FFD84D",
    "terminal.ansiBrightBlue": "#8FBFFF",
    "terminal.ansiBrightMagenta": "#F2A2D2",
    "terminal.ansiBrightCyan": "#9AE8E8",
    "terminal.ansiBrightWhite": "#FFFFFF",

    "button.background": "#004996",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#0A5CB5",
    "button.secondaryBackground": "#1C3358",
    "button.secondaryForeground": "#E8EDF5",
    "button.secondaryHoverBackground": "#24406B",
    "badge.background": "#FCBF00",
    "badge.foreground": "#000000",
    "progressBar.background": "#FCBF00",

    "input.background": "#0F2240",
    "input.foreground": "#E8EDF5",
    "input.border": "#1C3358",
    "input.placeholderForeground": "#5C7091",
    "inputOption.activeBorder": "#FCBF00",
    "dropdown.background": "#0F2240",
    "dropdown.border": "#1C3358",
    "checkbox.background": "#0F2240",
    "checkbox.border": "#2A4470",

    "scrollbarSlider.background": "#FFFFFF14",
    "scrollbarSlider.hoverBackground": "#FFFFFF24",
    "scrollbarSlider.activeBackground": "#00499699",

    "quickInput.background": "#0F2240",
    "quickInputList.focusBackground": "#00499699",
    "pickerGroup.foreground": "#FCBF00",
    "pickerGroup.border": "#1C3358",
    "menu.background": "#0F2240",
    "menu.foreground": "#E8EDF5",
    "menu.selectionBackground": "#00499699",
    "menu.separatorBackground": "#1C3358",
    "notifications.background": "#0F2240",
    "notifications.border": "#1C3358",
    "peekView.border": "#FCBF00",
    "peekViewEditor.background": "#0D1F3A",
    "peekViewResult.background": "#09172D",
    "peekViewTitle.background": "#0F2240",
    "peekViewEditor.matchHighlightBackground": "#FCBF0040",

    "gitDecoration.addedResourceForeground": "#7BC67E",
    "gitDecoration.modifiedResourceForeground": "#FCBF00",
    "gitDecoration.deletedResourceForeground": "#FF6B7F",
    "gitDecoration.untrackedResourceForeground": "#9BE09E",
    "gitDecoration.ignoredResourceForeground": "#4A5F80",
    "gitDecoration.conflictingResourceForeground": "#FFA552",
    "diffEditor.insertedTextBackground": "#4CAF5022",
    "diffEditor.removedTextBackground": "#E6264422",

    "scmGraph.historyItemRefColor": "#004996",
    "scmGraph.historyItemRemoteRefColor": "#003670",
    "scmGraph.historyItemBaseRefColor": "#4A5F80",
    "scmGraph.historyItemHoverLabelForeground": "#FFFFFF",
    "scmGraph.foreground1": "#FCBF00",
    "scmGraph.foreground2": "#6FA8F0",
    "scmGraph.foreground3": "#FFFFFF",
    "scmGraph.foreground4": "#FF6B7F",
    "scmGraph.foreground5": "#F5DC9A",

    "minimap.selectionHighlight": "#2A6BC080",
    "minimap.findMatchHighlight": "#FCBF00",
    "minimapGutter.modifiedBackground": "#FCBF00",
    "minimapGutter.addedBackground": "#4CAF50",
    "minimapGutter.deletedBackground": "#E62644"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7388A6", "fontStyle": "italic" }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other.important"
      ],
      "settings": { "foreground": "#6FA8F0" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "keyword.operator.assignment"],
      "settings": { "foreground": "#C9D4E5" }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.word"
      ],
      "settings": { "foreground": "#6FA8F0" }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": { "foreground": "#FCBF00" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#F5DC9A" }
    },
    {
      "name": "Template expressions",
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": { "foreground": "#6FA8F0" }
    },
    {
      "name": "Escapes and regex",
      "scope": ["constant.character.escape", "string.regexp"],
      "settings": { "foreground": "#FCBF00" }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": { "foreground": "#FF6B7F" }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.namespace"
      ],
      "settings": { "foreground": "#FFFFFF", "fontStyle": "bold" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": { "foreground": "#E8EDF5" }
    },
    {
      "name": "this / self",
      "scope": ["variable.language"],
      "settings": { "foreground": "#6FA8F0", "fontStyle": "italic" }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property"
      ],
      "settings": { "foreground": "#C9D4E5" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#8A9BB5" }
    },
    {
      "name": "HTML/XML tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#6FA8F0" }
    },
    {
      "name": "Components (JSX/Vue)",
      "scope": ["support.class.component", "entity.name.tag.vue"],
      "settings": { "foreground": "#FFFFFF", "fontStyle": "bold" }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#FCBF00", "fontStyle": "italic" }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": { "foreground": "#FCBF00", "fontStyle": "" }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name.css", "support.type.vendored.property-name"],
      "settings": { "foreground": "#E8EDF5", "fontStyle": "" }
    },
    {
      "name": "CSS values and units",
      "scope": ["support.constant.property-value.css", "keyword.other.unit"],
      "settings": { "foreground": "#FF6B7F" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#6FA8F0", "fontStyle": "" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#FCBF00", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#FFFFFF", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#6FA8F0" }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#F5DC9A" }
    },
    {
      "name": "Markdown quotes",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#8A9BB5", "fontStyle": "italic" }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#7BC67E" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#FF6B7F" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#FCBF00" }
    },
    {
      "name": "Python decorators",
      "scope": ["entity.name.function.decorator", "meta.decorator"],
      "settings": { "foreground": "#FF6B7F", "fontStyle": "italic" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#FF6B7F", "fontStyle": "underline" }
    }
  ],
  "semanticTokenColors": {
    "class": { "foreground": "#FFFFFF", "bold": true },
    "interface": { "foreground": "#FFFFFF", "bold": true },
    "type": { "foreground": "#FFFFFF", "bold": true },
    "enum": { "foreground": "#FFFFFF", "bold": true },
    "typeParameter": { "foreground": "#FFFFFF", "italic": true },
    "function": "#FCBF00",
    "method": "#FCBF00",
    "property": "#C9D4E5",
    "parameter": { "foreground": "#E8EDF5", "italic": true },
    "variable.readonly": "#FF6B7F",
    "enumMember": "#FF6B7F",
    "namespace": "#FFFFFF",
    "decorator": { "foreground": "#FF6B7F", "italic": true }
  }
}
